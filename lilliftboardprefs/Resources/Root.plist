<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>LilLiftBoard</string>
			<key>footerText</key>
			<string>Raises the keyboard so its bottom row stays clear of the home gesture area. Changes apply the next time the keyboard is shown; use Respring if an app keeps the old layout.</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>default</key>
			<true/>
			<key>defaults</key>
			<string>com.satoshiinu.lilliftboard</string>
			<key>key</key>
			<string>enabled</string>
			<key>label</key>
			<string>Enabled</string>
			<key>PostNotification</key>
			<string>com.satoshiinu.lilliftboard/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>default</key>
			<real>30</real>
			<key>defaults</key>
			<string>com.satoshiinu.lilliftboard</string>
			<key>key</key>
			<string>lift</string>
			<key>label</key>
			<string>Lift (pt)</string>
			<key>min</key>
			<real>0</real>
			<key>max</key>
			<real>50</real>
			<key>showValue</key>
			<true/>
			<key>PostNotification</key>
			<string>com.satoshiinu.lilliftboard/prefschanged</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>action</key>
			<string>respring</string>
			<key>label</key>
			<string>Respring</string>
		</dict>
		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>action</key>
			<string>openGitHub</string>
			<key>label</key>
			<string>Source Code (GitHub)</string>
		</dict>
	</array>
	<key>title</key>
	<string>LilLiftBoard</string>
</dict>
</plist>
